{
	"name": "express-crud",
	"version": "0.0.0",
	"private": true,
	"main": "dist/app.js",
	"scripts": {
		"build": "npx tsc app.ts",
		"start": "npx tsc && node dist/app.js",
		"dev": "ts-node-dev --respawn --transpile-only ./app.ts",
		"lint": "prettier ./.prettierrc . --write",
		"prepare": "husky install"
	},
	"dependencies": {
		"cookie-parser": "~1.4.4",
		"debug": "~2.6.9",
		"express": "^4.21.2",
		"mongodb": "^6.12.0",
		"morgan": "~1.9.1"
	},
	"devDependencies": {
		"@types/cookie-parser": "^1.4.8",
		"@types/express": "^5.0.0",
		"@types/morgan": "^1.9.9",
		"@types/node": "^22.10.5",
		"husky": "^9.1.7",
		"lint-staged": "^15.3.0",
		"prettier": "^3.4.2",
		"ts-node-dev": "^2.0.0",
		"typescript": "^5.7.2"
	},
	"lint-staged": {
		"*.{ts,js,json}": [
			"npm run lint"
		]
	}
}
